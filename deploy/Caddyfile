# Automatic HTTPS (Let's Encrypt) for $DOMAIN. /api/* goes straight to FastAPI, everything else to Next.js.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Recording parts are small, but allow headroom for the single-request upload fallback and CSV imports.
	# Learning hub files (ebooks, audio) get more; the backend enforces RESOURCE_MAX_MB (default 50 MB) itself.
	@hubUpload path_regexp ^/api/admin/resources/[^/]+/file$
	@otherRequests not path_regexp ^/api/admin/resources/[^/]+/file$
	request_body @hubUpload {
		max_size 110MB
	}
	request_body @otherRequests {
		max_size 25MB
	}

	handle /api/* {
		reverse_proxy backend:8000 {
			# Scoring and imports are background jobs, but large CSV dry runs can take a while.
			transport http {
				read_timeout 120s
			}
		}
	}

	handle {
		reverse_proxy frontend:3000
	}

	log {
		output stdout
		format json
	}
}

# Redirect www to the bare domain.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
