# Copy to .env and fill in. .env is gitignored; never commit real keys.
# docker compose overrides DATABASE_URL / S3_* for the containers (see docker-compose.yml).

# ---------------------------------------------------------------- app
ENVIRONMENT=development                 # development | test | production
APP_URL=http://localhost:3000           # public site URL (links in emails, Stripe redirects)
SECRET_KEY=change-me-to-a-long-random-string
COOKIE_SECURE=false                     # true behind HTTPS
SESSION_HOURS=12
CORS_ORIGINS=                           # comma-separated; empty = same-origin only (frontend proxies /api)

# First admin, created/updated by `python -m app.seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

# ---------------------------------------------------------------- database
DATABASE_URL=postgresql+psycopg://ccl:ccl@localhost:5433/ccl
TEST_DATABASE_URL=postgresql+psycopg://ccl:ccl@localhost:5433/ccl_test

# ---------------------------------------------------------------- storage (S3-compatible)
STORAGE_BACKEND=s3                      # s3 | local (local = files under backend/data/storage, dev/tests only)
S3_ENDPOINT_URL=http://localhost:9000   # empty for AWS; https://<region>.your-objectstorage.com for Hetzner
S3_REGION=ap-southeast-2
S3_BUCKET=ccl-dev
S3_ACCESS_KEY_ID=ccl-dev
S3_SECRET_ACCESS_KEY=ccl-dev-secret
MEDIA_DOWNLOAD_MAX_MB=50                # max size of an imported audio/waveform file

# ---------------------------------------------------------------- speech-to-text
STT_PROVIDER=auto                       # groq | mock | auto (groq when GROQ_API_KEY is set)
GROQ_API_KEY=
STT_MODEL=whisper-large-v3-turbo
STT_FALLBACK_MODEL=whisper-large-v3

# ---------------------------------------------------------------- AI evaluation (identifies errors, never scores)
EVALUATOR_PROVIDER=auto                 # gemini | anthropic | openai | mock | auto (gemini when GEMINI_API_KEY is set)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# ---------------------------------------------------------------- payments (Stripe)
STRIPE_SECRET_KEY=                      # sk_test_... in dev
STRIPE_WEBHOOK_SECRET=                  # whsec_... from `stripe listen` or the dashboard
STRIPE_PRICE_SELF_STUDY=                # price_... for the Self-Study plan
STRIPE_PRICE_COACHING=                  # price_... (optional; Coaching shows "Contact us" without it)
STRIPE_CHECKOUT_MODE=subscription       # subscription | payment

# ---------------------------------------------------------------- email (transactional)
EMAIL_PROVIDER=console                  # console | smtp | resend
EMAIL_FROM=Benchmark Education <no-reply@example.com>
EMAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
RESEND_API_KEY=
