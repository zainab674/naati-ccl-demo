# Copy to .env and fill in. .env is gitignored; never commit real keys.
# docker compose overrides DATABASE_URL / S3_* for the containers (see docker-compose.yml).
# Keep comments on their own lines: "KEY=   # comment" would make the comment the value.

# ---------------------------------------------------------------- production (docker-compose.prod.yml)
# Public domain served by Caddy with automatic HTTPS, e.g. ccl.benchmarkeducation.com.au
DOMAIN=
# Email for Let's Encrypt certificate notices
ACME_EMAIL=
# Password for the Postgres container in production
POSTGRES_PASSWORD=

# ---------------------------------------------------------------- app
# development | test | production
ENVIRONMENT=development
# Public site URL (links in emails, Stripe redirects)
APP_URL=http://localhost:3000
SECRET_KEY=change-me-to-a-long-random-string
# true behind HTTPS
COOKIE_SECURE=false
SESSION_HOURS=12
# Hours a "set your password" invite link stays valid for manually enrolled students
ENROLMENT_INVITE_HOURS=72
# Business time zone: a manual access end date lasts until midnight here
APP_TIMEZONE=Australia/Sydney
# Password for the demo students created by `python -m app.demo_data` (development only; refuses to run in production)
DEMO_PASSWORD=demo-pass-2026

# First admin, created/updated by `python -m app.seed`
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_FIRST_NAME=Admin
ADMIN_LAST_NAME=User

# ---------------------------------------------------------------- database
DATABASE_URL=postgresql+psycopg://ccl:ccl@localhost:5433/ccl
TEST_DATABASE_URL=postgresql+psycopg://ccl:ccl@localhost:5433/ccl_test

# ---------------------------------------------------------------- storage (S3-compatible)
# s3 | local (local = files under backend/data/storage, for dev/tests only)
STORAGE_BACKEND=s3
# Empty for AWS; https://<location>.your-objectstorage.com for Hetzner; http://localhost:9000 for the dev MinIO
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=ap-southeast-2
S3_BUCKET=ccl-dev
S3_ACCESS_KEY_ID=ccl-dev
S3_SECRET_ACCESS_KEY=ccl-dev-secret
# Max size of an imported audio/waveform file
MEDIA_DOWNLOAD_MAX_MB=50
# Largest learning hub file (ebook, audio) an admin can upload, in MB. Keep deploy/Caddyfile in step.
RESOURCE_MAX_MB=50

# ---------------------------------------------------------------- speech-to-text
# groq | mock | auto (groq when GROQ_API_KEY is set)
STT_PROVIDER=auto
GROQ_API_KEY=
STT_MODEL=whisper-large-v3-turbo
STT_FALLBACK_MODEL=whisper-large-v3

# ---------------------------------------------------------------- AI evaluation (identifies errors, never scores)
# gemini | anthropic | openai | mock | auto (gemini when GEMINI_API_KEY is set)
EVALUATOR_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# ---------------------------------------------------------------- payments (Stripe)
# sk_test_... in development
STRIPE_SECRET_KEY=
# whsec_... from `stripe listen` or the Stripe dashboard webhook endpoint
STRIPE_WEBHOOK_SECRET=
# price_... for the Self-Study plan
STRIPE_PRICE_SELF_STUDY=
# price_... for Coaching (optional; Coaching shows "Contact us" without it)
STRIPE_PRICE_COACHING=
# subscription | payment
STRIPE_CHECKOUT_MODE=subscription

# ---------------------------------------------------------------- email (transactional)
# console | smtp | resend
EMAIL_PROVIDER=console
EMAIL_FROM=Benchmark Education <no-reply@example.com>
EMAIL_REPLY_TO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
RESEND_API_KEY=
