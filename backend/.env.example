# Copy to .env and fill in. Everything works without keys (demo fallbacks),
# but real marking needs ANTHROPIC_API_KEY and real transcription needs
# GROQ_API_KEY or OPENAI_API_KEY.

SECRET_KEY=change-me-to-a-long-random-string

# AI marking (Claude). Without it, a static rule-based marker is used.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# Speech-to-text (Whisper). Groq is fastest/cheapest; OpenAI also works.
GROQ_API_KEY=
OPENAI_API_KEY=

# Optional overrides
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/ccl
# STT_PROVIDER=auto        # groq | openai | mock | auto
# MARKER_PROVIDER=auto     # claude | heuristic | auto
# COOKIE_SECURE=true       # set true behind HTTPS
